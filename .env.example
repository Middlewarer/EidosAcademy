# 1. Скопируйте этот файл в .env:
#    cp .env.example .env
#
# 2. Замените все значения на реальные данные

DEBUG=True

SECRET_KEY=your-secret-key-here

ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings

# Для PostgreSQL
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# Список разрешенных origin-ов
# Для разработки - локальные адреса
CORS_ORIGIN_1=http://localhost:5173
CORS_ORIGIN_2=http://localhost:3000
CORS_ORIGIN_3=http://127.0.0.1:5173
CORS_ORIGIN_4=http://127.0.0.1:3000

# Для продакшена замените значения CORS_ORIGIN_1–4 адресами frontend.
# Если адрес один, его можно повторить во всех четырёх переменных.
# В ALLOWED_HOSTS укажите домен backend без схемы и пути.
# Перед публикацией установите DEBUG=False.
