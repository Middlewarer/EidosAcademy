# 1. Скопируйте этот файл в .env:
#    cp .env.example .env
#
# 2. Замените все значения на реальные данные

DEBUG=True

SECRET_KEY=your-secret-key-here

ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings

# Для PostgreSQL
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# Списки значений через запятую
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Для продакшена укажите HTTPS-адрес frontend.
# В ALLOWED_HOSTS укажите домен backend без схемы и пути.
# Перед публикацией установите DEBUG=False.

REDIS_URL=redis://127.0.0.1:6379/1
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO
